# Public Supabase Configuration (Browser-safe ONLY)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL in /web!
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Show the "Create Account" tab (also requires sign-up enabled in Supabase Auth). Default: off.
VITE_ALLOW_SIGNUP=false
